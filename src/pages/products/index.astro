---
// Importing necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
import CardSmall from "@components/ui/cards/CardSmall.astro";
import CardWide from "@components/ui/cards/CardWide.astro";
import FeaturesStatsAlt from "@components/sections/features/FeaturesStatsAlt.astro";
import TestimonialsSectionAlt from "@components/sections/testimonials/TestimonialsSectionAlt.astro";

// Importing necessary functions from Astro
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { SITE } from "@data/constants";

// Fetching all the product related content and sorting it by main.id
const product: CollectionEntry<"products">[] = (
  await getCollection("products", ({ id }) => {
    return id.startsWith("en/");
  })
).sort(
  (a: CollectionEntry<"products">, b: CollectionEntry<"products">) =>
    a.data.main.id - b.data.main.id
);

// Define variables for page content
const title: string = "Productos";
const subTitle: string =
  "Aire, Agua, Aceite y Polvo. Garantiza la pureza en cada etapa de tu producción. Navega entre nuestra gama de soluciones estándar o solicita fabricaciones a medida, diseñadas para capturar desde partículas sólidas hasta neblinas invisibles, protegiendo la integridad de tu maquinaria y la continuidad de tu operación.";

// Testimonial data that will be rendered in the component
const testimonials = [
  // First testimonial data
  {
    content:
      "Importábamos costosos filtros de Estados Unidos, generando altos costos y demoras. Micrafil desarrolló filtros de alta calidad localmente, reduciendo costos y tiempos de entrega, convirtiéndose en nuestro aliado estratégico.",
    author: "Carlos Rodríguez",
    role: "Gerente de Mantenimiento | Soluciones y procesos en automatización",
    avatarSrc:
      "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
  // Second testimonial data
  {
    content:
      "Manejábamos múltiples proveedores con problemas de tiempos de entrega y calidad. Micrafil ofreció soluciones personalizadas y precios justos, optimizando nuestra cadena de suministro y convirtiéndose en nuestro socio estratégico.",
    author: "Ana García",
    role: "Gerenta de Compras | Sand Technologies",
    avatarSrc:
      "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1376&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
  // Third testimonial data
  {
    content:
      "La obstrucción de boquillas generaba mantenimientos frecuentes. Micrafil proporcionó un sistema antisarro efectivo, reduciendo los costosos mantenimientos en un 57%, mejorando la eficiencia operativa.",
    author: "Miguel Ángel López",
    role: "Gerente de Producción | Plásticos Ceccan",
    avatarSrc:
      "https://images.unsplash.com/photo-1474176857210-7287d38d27c6?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80",
    avatarAlt: "Image Description",
  },
];

const pageTitle: string = `Productos de Filtración | Micrafil`;
const metaDescription =
  "Catálogo de soluciones en filtración industrial: Aire, Líquidos e Hidráulica. Fabricación a medida y refacciones especializadas con más de 20 años de experiencia en el Bajío.";
const ogTitle = "Catálogo de Filtración Industrial | Micrafil";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://micrafil.com/products",
    url: "https://micrafil.com/products",
    name: "Catálogo de Filtración Industrial | Micrafil",
    description:
      "Catálogo de soluciones en filtración industrial: Aire, Líquidos e Hidráulica. Fabricación a medida y refacciones especializadas con más de 20 años de experiencia en el Bajío.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://micrafil.com",
      name: "Micrafil",
      description:
        "Micrafil ofrece soluciones integrales en filtración industrial con más de 20 años de experiencia en el Bajío. Especialistas en aire, líquidos e hidráulica.",
    },
    inLanguage: "es-MX",
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
        >
          {title}
        </h1>
        {
          subTitle && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
              {subTitle}
            </p>
          )
        }
      </div>
      <PrimaryCTA title="Casos de éxito" url="#testimonials" noArrow={true} />
    </div>
    {/* Displaying products in alternating styles. Alternative product gets different card styling.
    Maps through all product entries and displays them with either CardSmall or CardWide based on their position. */}
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        product.map((product, index) => {
          const position = index % 4;
          if (position === 0 || position === 3) {
            return <CardSmall product={product} />;
          } else {
            return <CardWide product={product} />;
          }
        })
      }
    </section>
  </div>
  {/* Features statistics section */}
  <FeaturesStatsAlt
    title="¿Por qué elegir Micrafil?"
    subTitle="Más que un proveedor, somos tu departamento de ingeniería en filtración. Con más de 20 años de experiencia, transformamos problemas de contaminación en procesos eficientes, garantizando la calidad de tu producto final desde el primer ciclo."
    benefits={[
      "Solidez Comprobada: Sistemas de filtración de alta durabilidad y rendimiento constante, validados por la industria local.",
      "Fabricación Especializada: Soluciones a medida para equipos especiales o descontinuados que optimizan tu producción sin modificar tu maquinaria.",
      "Cobertura Estratégica: Asesoría técnica y diagnóstico especializado con atención directa y respuesta rápida en los principales corredores industriales.",
    ]}
  />
  {/* Testimonials section */}
  <TestimonialsSectionAlt
    title="¿Qué dicen nuestros clientes?"
    testimonials={testimonials}
  />
</MainLayout>
