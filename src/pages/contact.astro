---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import ContactSection from "@components/sections/misc/ContactSection.astro";
import { SITE } from "@data/constants";

const pageTitle: string = `Contacto e Ingeniería | Micrafil`;
const metaDescription =
  "Conecte con nuestro departamento de ingeniería para cotizaciones, validación técnica y diseño de sistemas de filtración. Ubicados en Terra Business Park, Querétaro.";
const ogTitle = "Hablemos de Ingeniería | Micrafil";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://micrafil.com/contact",
    url: "https://micrafil.com/contact",
    name: "Contacto e Ingeniería | Micrafil",
    description:
      "Solicite asesoría técnica y cotizaciones para proyectos de filtración industrial. Atención directa de ingeniería en Querétaro y Bajío.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://micrafil.com",
      name: "Micrafil",
      description:
        "Micrafil ofrece ingeniería, manufactura y mantenimiento de sistemas de filtración industrial con cobertura en Querétaro y Guanajuato.",
    },
    inLanguage: "es-MX",
  }}
>
  <ContactSection />
</MainLayout>
