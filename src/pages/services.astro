---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import diagnostico1 from "@images/Diagnostico1.png";
import diagnostico2 from "@images/Diagnostico2.png";
import ingenieriaTangible from "@images/IngenieriaTangible.png";
import adaptacion1 from "@images/Adaptacion.png";
import adaptacion2 from "@images/Adaptacion2.png";
import blindaje from "@images/Blindaje.png";
import correctivo1 from "@images/Correctivo.png";
import correctivo2 from "@images/Correctivo2.png";
import { SITE } from "@data/constants";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Diagnóstico Industrial de Alto Impacto",
    subTitle:
      "Deje de adivinar por qué sus filtros se saturan o por qué su calidad fluctúa. Nuestra asesoría es una intervención técnica basada en más de 20 años de maestría en campo. Analizamos la causa raíz y dictamos la solución exacta para optimizar su inversión desde el primer ciclo.",
    single: false,
    imgOne: diagnostico1,
    imgOneAlt: "Diagnóstico industrial de alto impacto",
    imgTwo: diagnostico2,
    imgTwoAlt: "Análisis técnico de sistemas de filtración",
    btnExists: true,
    btnTitle: "Solicitar Revisión Técnica",
    btnURL: "/contact",
  },
  {
    isRightSection: false,
    title: "Manufactura Propia",
    subTitle:
      "No solo diseñamos, construimos. Nuestra planta produce soluciones de filtración industrial robustas, adaptadas a cualquier infraestructura. Al fabricar internamente, garantizamos que cada soldadura y cada costura cumplan con la especificación más crítica de todas: funcionar en su planta a la primera, sin adaptaciones improvisadas.",
    img: ingenieriaTangible,
    imgAlt: "Ingeniería tangible y manufactura propia de sistemas de filtración",
    btnExists: true,
    btnTitle: "Evaluar Viabilidad Técnica",
    btnURL: "https://wa.me/524423560603",
  },
  {
    isRightSection: true,
    title: "Diseño y Reingeniería",
    subTitle:
      "No obligue a su planta a adaptarse a un filtro genérico. Diseñamos e integramos sistemas de filtración que se acoplan con precisión milimétrica a su infraestructura existente. Resolvemos desafíos de espacio y flujo en equipos descontinuados donde otros se rinden.",
    single: false,
    imgOne: adaptacion1,
    imgOneAlt: "Ingeniería de adaptación y reingeniería de equipos",
    imgTwo: adaptacion2,
    imgTwoAlt: "Sistemas de filtración adaptados a infraestructura existente",
    btnExists: true,
    btnTitle: "Cotizar Modernización",
    btnURL: "/contact",
  },
  {
    isRightSection: false,
    title: "Blindaje Preventivo",
    subTitle:
      "El mantenimiento no es un gasto, es el seguro de su calidad y eficiencia operativa. Ejecutamos programas estratégicos de mantenimiento preventivo bajo demanda, diseñados para erradicar paros no programados y blindar su continuidad operativa.",
    img: blindaje,
    imgAlt: "Blindaje preventivo y mantenimiento de sistemas de filtración",
    btnExists: true,
    btnTitle: "Planificar Mantenimiento",
    btnURL: "/contact",
  },
  {
    isRightSection: true,
    title: "Mantenimiento Correctivo Especializado",
    subTitle:
      "Cuando su sistema de filtración colapsa, necesita soluciones definitivas, no parches temporales. Nuestro equipo técnico responde a fallas críticas con diagnósticos precisos. Ejecutamos reparaciones integrales en cualquier componente dañado o saturado, devolviendo su equipo a sus parámetros de diseño originales y asegurando su operación.",
    single: false,
    imgOne: correctivo1,
    imgOneAlt: "Correctivo de sistemas de filtración",
    imgTwo: correctivo2,
    imgTwoAlt: "Reparación y mantenimiento correctivo de equipos",
    btnExists: true,
    btnTitle: "Solicitar Soporte Técnico",
    btnURL: "https://wa.me/524423560603",
  },
];

const pageTitle: string = `Servicios de Ingeniería y Manufactura | Micrafil`;
const metaDescription =
  "Soluciones integrales en filtración industrial: Desde el diseño y fabricación de filtros a medida hasta mantenimiento correctivo urgente en Querétaro y el Bajío.";
const ogTitle = "Servicios de Filtración Industrial | Micrafil";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://micrafil.com/services",
    url: "https://micrafil.com/services",
    name: "Servicios de Filtración Industrial | Micrafil",
    description:
      "Soluciones integrales en filtración industrial: Desde el diseño y fabricación de filtros a medida hasta mantenimiento correctivo urgente en Querétaro y el Bajío.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://micrafil.com",
      name: "Micrafil",
      description:
        "Micrafil ofrece soluciones integrales en filtración industrial con más de 20 años de experiencia en el Bajío. Especialistas en aire, líquidos e hidráulica.",
    },
    inLanguage: "es-MX",
  }}
>
  {/* MainSection is the introductory section of the page, it also contains a CTA button */}
  <MainSection
    title="Dominio Técnico en Filtración: Ingeniería que Ejecuta"
    subTitle="En Micrafil no solo teorizamos; materializamos soluciones. Integramos diagnóstico, diseño y manufactura propia para garantizar que su producción nunca se detenga por un filtro."
    btnExists={true}
    btnTitle="Agendar Diagnóstico Técnico"
    btnURL="/contact"
  />
  {/* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */}
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="Sectores de Impacto"
    subTitle="No existe una solución única para todos. Adaptamos nuestra ingeniería de filtración a las exigencias normativas y operativas críticas de cada industria."
    mainStatTitle="20+"
    mainStatSubTitle="años de experiencia especializada en filtración industrial"
    stats={[
      {
        stat: "Automotriz",
        description: "Control de neblinas de aceite y humos de soldadura en líneas de ensamblaje.",
      },
      {
        stat: "Metalmecánica",
        description: "Captación de polvos abrasivos y virutas en procesos de maquinado CNC.",
      },
      {
        stat: "Alimenticia",
        description: "Filtración sanitaria y manejo de polvos orgánicos bajo normativa.",
      },
      {
        stat: "Plásticos",
        description: "Recuperación de material y control de polvos en inyección y extrusión.",
      },
    ]}
  />
</MainLayout>
