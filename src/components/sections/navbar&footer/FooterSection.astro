---
// Import the necessary dependencies
import FooterSocialLink from "@components/ui/links/FooterSocialLink.astro";
import EmailFooterInput from "@components/ui/forms/input/EmailFooterInput.astro";
import esStrings from "@utils/navigation.ts";
import enStrings from "@/utils/en/navigation";
import Icon from "@components/ui/icons/Icon.astro";
import MicrafilLogo from "@images/starlight/MIcrafilLogoLight.svg";
import { SITE } from "@data/constants";

// Select the correct translation based on the page's lang prop:
const strings = Astro.currentLocale === "en" ? enStrings : esStrings;

// Define the variables that will be used in this component
const sectionThreeTitle: string = Astro.currentLocale === "en" ? "Newsletter" : "Newsletter";
const sectionThreeContent: string = Astro.currentLocale === "en" ? "Receive updates on new filtration solutions and exclusive offers." :
  "Recibe actualizaciones sobre nuevas soluciones de filtración y ofertas exclusivas.";
const crafted: string = Astro.currentLocale === "en" ? "Crafted by" : "Creado por";
---

<footer class="w-full bg-micrafil-blue-600 dark:bg-micrafil-blue-600">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        <!-- Brand Logo -->
        <MicrafilLogo class="h-auto w-32" />
      </div>
      <!-- An array of links for Product and Company sections -->
      {
        strings.footerLinks.map((section) => (
          <div class="col-span-1">
            <h3 class="font-bold text-ui-text-primary dark:text-ui-text-primary">
              {section.section}
            </h3>
            <ul class="mt-3 grid space-y-3">
              {section.links.map((link, index) => (
                <li>
                  <a
                    href={link.url}
                    class={`inline-flex gap-x-2 rounded-lg text-ui-text-secondary outline-hidden ring-zinc-500 transition duration-300 hover:text-ui-text-primary focus-visible:ring-3 dark:text-ui-text-secondary dark:ring-zinc-200 dark:hover:text-ui-text-primary dark:focus:outline-hidden ${link.badge ? 'pointer-events-none opacity-60' : ''}`}
                  >
                    {link.name}
                  </a>
                  {link.badge ? (
                    <span class="ms-1 inline rounded-lg bg-micrafil-gold-500 px-2 py-1 text-xs font-bold text-micrafil-blue-600">
                      {link.badge}
                    </span>
                  ) : null}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="col-span-2">
        <h3 class="font-bold text-ui-text-primary dark:text-ui-text-primary">
          {sectionThreeTitle}
        </h3>

        <form action="https://formspree.io/f/xkoqvwpd" method="POST" data-track="conversion_newsletter">
          <EmailFooterInput />
        </form>
      </div>
    </div>

    <div
      class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <div class="flex items-center justify-between">
        <p class="text-sm text-ui-text-secondary dark:text-ui-text-secondary">
          © <span id="current-year"></span> {SITE.title}. {crafted}
          <a
            class="rounded-lg font-medium underline underline-offset-2 outline-hidden ring-zinc-500 transition duration-300 hover:text-ui-text-primary hover:decoration-dashed focus:outline-hidden focus-visible:ring-3 dark:ring-zinc-200 dark:hover:text-ui-text-primary"
            href="https://www.instagram.com/hochtx/"
            target="_blank"
            rel="noopener noreferrer"
            data-track="conversion_rodrigo_estilla">Rodrigo Estilla</a
          >.
        </p>
      </div>

      <!-- Social Brands -->
      <div>
        <FooterSocialLink url="tel:+5214423560603"
          dataTrack="conversion_telefono"
          ><Icon name="phone" />
        </FooterSocialLink>
        
        <FooterSocialLink url={strings.socialLinks.facebook}
          dataTrack="conversion_facebook"
          ><Icon name="facebookFooter" />
        </FooterSocialLink>

        {/* <FooterSocialLink url={strings.socialLinks.x}
          ><Icon name="xFooter" /></FooterSocialLink
        > */}

        {/* <FooterSocialLink url={strings.socialLinks.github}
          ><Icon name="githubFooter" />
        </FooterSocialLink> */}

        <FooterSocialLink url={strings.socialLinks.google}
          dataTrack="conversion_google"
          ><Icon name="googleFooter" />
        </FooterSocialLink>

        {/* <FooterSocialLink url={strings.socialLinks.slack}
          ><Icon name="slackFooter" />
        </FooterSocialLink> */}
        <FooterSocialLink url={strings.socialLinks.instagram}
          dataTrack="conversion_instagram"
          ><Icon name="instagramFooter" />
        </FooterSocialLink>
        <FooterSocialLink url={strings.socialLinks.linkedin}
          dataTrack="conversion_linkedin"
          ><Icon name="linkedIn" />
        </FooterSocialLink>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById("current-year");
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
