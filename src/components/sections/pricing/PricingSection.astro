---
// Import SecondaryCTA component for use in this module
import SecondaryCTA from "@components/ui/buttons/SecondaryCTA.astro";
import Icon from "@components/ui/icons/Icon.astro";

// Define props from Astro
const { pricing } = Astro.props;

// Define TypeScript type for products.
type Product = {
  name: string;
  description: string;
  price: string;
  cents: string;
  billingFrequency: string;
  features: Array<string>;
  purchaseBtnTitle: string;
  purchaseLink: string;
};

interface PricingSectionProps {
  title: string;
  subTitle: string;
  badge: string;
  thirdOption: string;
  btnText: string;
  pricing: {
    title: string;
    subTitle: string;
    starterKit: Product;
    professionalToolbox: Product;
  };
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <!-- Section heading and sub-heading -->
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-balance text-2xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight"
    >
      {pricing.title}
    </h2>
    <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
      {pricing.subTitle}
    </p>
  </div>
  <!-- Contains two main product blocks -->
  <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-0">
    <!-- Starter Kit product details -->
    <div
      class="w-full rounded-xl bg-micrafil-blue-600 p-6 sm:w-1/2 sm:rounded-r-none sm:p-8 lg:w-1/3"
    >
      <div class="mb-4">
        <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
          {pricing.starterKit.name}
        </h3>
        <p class="text-ui-text-secondary">{pricing.starterKit.description}</p>
      </div>

      <div class="mb-4">
        <span class="text-4xl font-bold text-ui-text-primary"
          >{pricing.starterKit.price}</span
        >
        <span class="text-lg font-bold text-ui-text-secondary"
          >{pricing.starterKit.cents}</span
        >
        <span class="ms-3 text-sm text-ui-text-secondary"
          >{pricing.starterKit.billingFrequency}</span
        >
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-ui-text-primary">
        {
          pricing.starterKit.features.map((feature: string) => (
            <li class="flex items-center gap-1.5">
              <Icon name="checkCircle" />

              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <a
        href={pricing.starterKit.purchaseLink}
        class="block rounded-lg bg-micrafil-gold-500 px-8 py-3 text-center text-sm font-bold text-micrafil-blue-600 outline-hidden ring-micrafil-blue-400 transition-all duration-300 hover:bg-micrafil-gold-600 hover:text-micrafil-blue-700 hover:ring-micrafil-blue-500 hover:scale-105 focus-visible:ring-3 active:bg-micrafil-gold-700 active:text-micrafil-blue-800 md:text-base"
        data-track="conversion_telefono"
        >{pricing.starterKit.purchaseBtnTitle}</a
      >
    </div>
    <!-- Professional Toolbox product details -->
    <div
      class="w-full rounded-xl bg-micrafil-blue-900 p-6 shadow-xl sm:w-1/2 sm:p-8"
    >
      <div
        class="mb-4 flex flex-col items-start justify-between gap-4 lg:flex-row"
      >
        <div>
          <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
            {pricing.professionalToolbox.name}
          </h3>
          <p class="text-ui-text-secondary">{pricing.professionalToolbox.description}</p>
        </div>

        {/* Badge temporalmente comentado para evitar confusión visual
        <span
          class="order-first inline-block rounded-full bg-micrafil-gold-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-center text-micrafil-blue-600 lg:order-none"
          >{pricing.badge}</span
        >
        */}
      </div>

      <div class="mb-4">
        <span class="text-6xl font-bold text-ui-text-primary"
          >{pricing.professionalToolbox.price}</span
        >
        <span class="text-lg font-bold text-ui-text-secondary"
          >{pricing.professionalToolbox.cents}</span
        >
        <span class="ms-3 text-ui-text-secondary"
          >{pricing.professionalToolbox.billingFrequency}</span
        >
      </div>
      <!-- Features list - automatically created by mapping over `features` array -->
      <ul class="mb-6 space-y-2 text-ui-text-secondary">
        {
          pricing.professionalToolbox.features.map((feature: string) => (
            <li class="flex items-center gap-1.5">
              <Icon name="checkCircle" />

              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      <!-- CTA for purchasing the product -->
      <a
        href={pricing.professionalToolbox.purchaseLink}
        class="block rounded-lg bg-micrafil-gold-500 px-8 py-3 text-center text-sm font-bold text-micrafil-blue-600 outline-hidden ring-micrafil-blue-400 transition-all duration-300 hover:bg-micrafil-gold-600 hover:text-micrafil-blue-700 hover:ring-micrafil-blue-500 hover:scale-105 focus-visible:ring-3 active:bg-micrafil-gold-700 active:text-micrafil-blue-800 md:text-base"
        data-track="conversion_whatsapp"
        >{pricing.professionalToolbox.purchaseBtnTitle}</a
      >
    </div>
  </div>
  <!-- Call to action for Enterprise Solutions -->
  <div class="mt-8 flex items-center justify-center gap-x-3 md:mt-12">
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      {pricing.thirdOption}
    </p>

    <SecondaryCTA title={pricing.btnText} url="https://wa.me/5214423560603" dataTrack="conversion_whatsapp" />
  </div>
</section>