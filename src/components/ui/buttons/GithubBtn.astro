---
import Icon from "@components/ui/icons/Icon.astro";
const { title, url, dataTrack } = Astro.props;

interface Props {
  title?: string;
  url?: string;
  dataTrack?: string;
}

const baseClasses =
  "group inline-flex items-center justify-center gap-x-3 rounded-lg px-4 py-3 text-center text-sm font-medium text-neutral-700 ring-zinc-500 focus-visible:ring-3 transition duration-300 outline-hidden";
const borderClasses = "border border-transparent";
const bgColorClasses = "bg-micrafil-gold-500 dark:focus:outline-hidden";
const hoverClasses = "hover:shadow-2xl hover:shadow-micrafil-gold-600";
const fontSizeClasses = "2xl:text-base";
const ringClasses = "dark:ring-zinc-200";
const iconColorClasses = "text-neutral-700 dark:text-neutral-700";
---

<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${fontSizeClasses} ${ringClasses}`}
  href={url}
  data-track={dataTrack}
>
  <Icon name="phoneHeader" class={iconColorClasses} />
  {title}
</a>
